{{ 'section-page-banner.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  A page's opening band: a heading and a few lines, centred on a colour band.
  Built for the Контакти page after the reference's contact banner. The
  reference lays those words over a photograph; here the band is a colour,
  since the homepage hero stays the only place words sit on a picture.

  Measured off the reference at 1440px: a 400px band with a 40px heading and
  16px text. On a 375px phone the band is 259px, which the 0.65 below follows.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-banner {
    min-height: {{ section.settings.min_height | times: 0.65 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-banner {
      min-height: {{ section.settings.min_height }}px;
    }
  }
{%- endstyle -%}

<div class="page-banner section-{{ section.id }}-banner color-{{ section.settings.color_scheme }} gradient">
  <div class="page-banner__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h1 class="page-banner__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="page-banner__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Как можем да помогнем?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Height on desktop",
      "info": "Phones get about two thirds of it.",
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}
