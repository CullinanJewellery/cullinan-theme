{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-category-mosaic.css' | asset_url | stylesheet_tag }}
<script src="{{ 'category-slider.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  A mosaic of category tiles.

  Layout follows the reference: four columns, with tall tiles spanning both
  rows at each end and square tiles filling the middle. The order of the blocks
  drives it — put a tall tile first and fourth and the grid falls into place,
  because grid-auto-flow: dense backfills the squares around them.

  Captions sit below the image by default rather than over it. See CLAUDE.md:
  the hero is the only place words sit on a photograph, and a dark scrim across
  the bottom of a gold photograph dulls the gold. Set "Caption position" to
  "Over the image" for the reference's treatment.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="mosaic page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="mosaic__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul
      class="mosaic__grid mosaic__grid--caption-{{ section.settings.caption_position }}"
      role="list"
      style="--mosaic-gap: {{ section.settings.gap }}px; --mosaic-scrim: {{ section.settings.scrim_opacity | divided_by: 100.0 }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
        -%}
        <li
          class="mosaic__item mosaic__item--{{ block.settings.size }}"
          {{ block.shopify_attributes }}
        >
          {%- capture tile -%}
            <span class="mosaic__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'mosaic__image',
                    widths: '400, 600, 900, 1200',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: ''
                }}
              {%- else -%}
                {%- comment -%}
                  No photograph yet. A flat block at the tile's shape, so the
                  mosaic reads as finished and nothing moves once images land.
                {%- endcomment -%}
                <span class="mosaic__image mosaic__image--empty"></span>
              {%- endif -%}
            </span>

            {%- if block.settings.label != blank or block.settings.subline != blank -%}
              <span class="mosaic__caption">
                {%- if block.settings.label != blank -%}
                  <span class="mosaic__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.subline != blank -%}
                  <span class="mosaic__subline">{{ block.settings.subline | escape }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endcapture -%}

          {%- comment -%}
            A tile with no destination is not a link. Structure can exist before
            content; navigation cannot.
          {%- endcomment -%}
          {%- if has_link -%}
            <a class="mosaic__tile" href="{{ block.settings.link }}">{{ tile }}</a>
          {%- else -%}
            <span class="mosaic__tile">{{ tile }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%}
      Phones only (2026-10-05, owner): the same categories as a slider -- a large
      photo, the name and one button to the collection (the short sentence was removed
      2026-10-06, owner: it repeated workshop facts). The next slide shows at the edge;
      scroll-snap swiping; two circular arrows (44x44) under it, disabled at the ends;
      line indicators under it (back 2026-10-07, in place of the arrows), no counter, no autoplay. Hidden from
      750px, where the mosaic above is shown. Only tiles with a link appear here.
    {%- endcomment -%}
    <category-slider class="mosaic-slider">
      <ul class="mosaic-slider__track" role="list" aria-label="{{ section.settings.heading | default: 'Категории' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <li class="mosaic-slider__slide">
              <a class="mosaic-slider__media" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'mosaic-slider__image',
                      widths: '400, 600, 900',
                      sizes: '82vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  <span class="mosaic-slider__image mosaic-slider__image--empty"></span>
                {%- endif -%}
              </a>
              <h3 class="mosaic-slider__name">{{ block.settings.label | escape }}</h3>
              <a class="mosaic-slider__button" href="{{ block.settings.link }}">
                {{- block.settings.phone_button | default: 'Разгледайте' | escape -}}
                <span class="visually-hidden">: {{ block.settings.label | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- comment -%}
        Line indicators, one per slide, centred under the slides (2026-10-07, owner: no
        previous/next arrows; swiping, the peek and tappable lines stay). Each line is a
        44px-tall button that goes to its slide; the current one is marked.
      {%- endcomment -%}
      {%- liquid
        assign cat_total = 0
        for block in section.blocks
          if block.settings.link != blank
            assign cat_total = cat_total | plus: 1
          endif
        endfor
      -%}
      <div class="mosaic-slider__controls" hidden>
        <div class="mosaic-slider__lines" role="group" aria-label="Категории">
          {%- for i in (1..cat_total) -%}
            <button
              type="button"
              class="mosaic-slider__line"
              data-cat-go="{{ forloop.index0 }}"
              aria-label="Категория {{ i }} от {{ cat_total }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            ></button>
          {%- endfor -%}
        </div>
      </div>
    </category-slider>

    {%- comment -%}
      „Вижте всички бижута“ under the categories, to the whole catalogue (2026-10-05, owner);
      a quiet underlined text link since 2026-10-06 (owner), so the category buttons lead.
    {%- endcomment -%}
    {%- if section.settings.all_label != blank -%}
      <div class="mosaic__all center">
        <a class="mosaic__all-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Category mosaic",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "all_label",
      "default": "Вижте всички бижута",
      "label": "Link to the whole catalogue",
      "info": "Leads to all products; an underlined text link under the categories. Empty: no link."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Разгледайте по категория",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Colour scheme"
    },
    {
      "type": "select",
      "id": "caption_position",
      "options": [
        { "value": "below", "label": "Below the image" },
        { "value": "over", "label": "Over the image" }
      ],
      "default": "below",
      "label": "Caption position",
      "info": "Over the image needs a dark scrim to stay readable, which dulls gold photography. Below keeps the picture clean."
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Scrim strength",
      "info": "Only used when the caption sits over the image.",
      "default": 55
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between tiles",
      "default": 14
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "options": [
            { "value": "standard", "label": "Square" },
            { "value": "tall", "label": "Tall (two rows)" }
          ],
          "default": "standard",
          "label": "Size",
          "info": "Make the first and fourth tiles tall to get the reference's layout."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty until the photography exists — a flat tile is shown."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Subline",
          "info": "Hidden when empty."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Without a destination the tile is shown but is not a link."
        },
        {
          "type": "header",
          "content": "Phone slider"
        },
        {
          "type": "text",
          "id": "phone_button",
          "label": "Button text (phones)",
          "info": "Empty: „Разгледайте“."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category mosaic",
      "blocks": [
        { "type": "tile", "settings": { "size": "tall" } },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile", "settings": { "size": "tall" } },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
