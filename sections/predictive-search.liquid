{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- comment -%}
  Search results while typing (2026-10-21, owner: the search „like theirs“, moonmagic.com). Left column: Shopify's
  own suggestions (words and collections) when it has any, then „Популярни търсения“ (snippets/cj-search-popular);
  right: the matching pieces as the site's own product cards (photo, hover photo, colour circles, price), up to
  eight (assets/predictive-search.js asks for eight); under them „Вижте всички резултати за „…““, which opens the
  search page. Nothing found: a sentence instead of the cards, the popular searches still there.
  The ids, roles and data attributes are the ones assets/predictive-search.js reads (keyboard and screen readers).
{%- endcomment -%}
<div id="predictive-search-results" role="listbox">
  {%- if predictive_search.performed -%}
    {%- liquid
      assign cj_products = predictive_search.resources.products
      assign cj_suggest_count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
      assign total_results = cj_products.size | plus: cj_suggest_count
    -%}
    <div id="predictive-search-results-groups-wrapper" class="cj-search__panel">
      <div class="cj-search__side">
        {%- if cj_suggest_count > 0 -%}
          <div class="cj-search__suggest">
            <h2 id="predictive-search-queries" class="cj-search__label">Предложения</h2>
            <ul
              id="predictive-search-results-queries-list"
              class="cj-search__popular-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-queries"
            >
              {%- for query in predictive_search.resources.queries -%}
                <li id="predictive-search-option-query-{{ forloop.index }}" role="option" aria-selected="false">
                  <a href="{{ query.url }}" class="cj-search__popular-link" tabindex="-1" aria-label="{{ query.text | escape }}">
                    {{- query.styled_text -}}
                  </a>
                </li>
              {%- endfor -%}
              {%- for collection in predictive_search.resources.collections -%}
                <li id="predictive-search-option-collection-{{ forloop.index }}" role="option" aria-selected="false">
                  <a href="{{ collection.url }}" class="cj-search__popular-link" tabindex="-1">
                    {{- collection.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- render 'cj-search-popular' -%}
      </div>

      <div class="cj-search__products collection">
        {%- if cj_products.size > 0 -%}
          <h2 id="predictive-search-products" class="cj-search__label">Бижута</h2>
          <ul
            id="predictive-search-results-products-list"
            class="cj-search__grid list-unstyled"
            role="group"
            aria-labelledby="predictive-search-products"
          >
            {%- for product in cj_products -%}
              <li
                id="predictive-search-option-product-{{ forloop.index }}"
                class="cj-search__card"
                role="option"
                aria-selected="false"
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  lazy_load: false,
                  show_secondary_image: true,
                  section_id: 'predictive-search',
                  product_view_context: 'search'
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="cj-search__empty">
            Няма бижута за „{{ predictive_search.terms | escape }}“. Опитайте с друга дума или изберете от популярните търсения.
          </p>
        {%- endif -%}
      </div>
    </div>

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}

    {%- if cj_products.size > 0 -%}
      <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button cj-search__all">
        <button
          class="predictive-search__item predictive-search__item--term cj-search__all-button"
          tabindex="-1"
          role="option"
          aria-selected="false"
        >
          <span data-predictive-search-search-for-text>Вижте всички резултати за „{{ predictive_search.terms | escape }}“</span>
        </button>
      </div>
    {%- endif -%}

    <span
      class="hidden"
      data-predictive-search-live-region-count-value
      data-total-results="{{ total_results }}"
    >
      {%- liquid
        if total_results == 0
          echo 'templates.search.no_results' | t: terms: predictive_search.terms
        else
          echo 'templates.search.results_with_count' | t: count: total_results
        endif
      -%}
    </span>
  {%- endif -%}
</div>
