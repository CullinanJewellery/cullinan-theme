{{ 'section-social-band.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The Facebook/Instagram block for product pages, after moonmagic's own
  "See It Styled On Instagram" band (2026-10-01, at the owner's request:
  "when we open a product Вижте работата ни section is there but i don't want
  it like that, it can stay like this just for the homepage ... for the
  products i want it like section See It Styled On Instagram but just the
  buttons and the text, i don't want the pictures down").

  Theirs is a full-width light-grey ground, a centred heading and a line
  under it, two solid black square buttons with an icon beside the label, and
  then a row of Instagram pictures. This is all of it except the pictures.

  The homepage keeps its own look in sections/social-follow.liquid, and every
  other page keeps the footer's copy of the same block. The footer stops
  printing its copy on product pages (sections/footer.liquid), so a product
  page never shows both.

  Its own markup and stylesheet rather than the footer's classes: those carry
  the pill shape and the brand colours the owner asked for on the homepage
  block, and this one wants neither, so reusing them would have meant
  overriding most of what they say.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}

{%- if has_social_icons -%}
  <div class="social-band color-{{ section.settings.color_scheme }} gradient">
    <div class="social-band__inner page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="social-band__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="social-band__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="social-band__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- render 'social-icons', class: 'social-band__buttons' -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Social band",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-2",
      "label": "Colour scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Вижте работата ни",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "default": "Последвайте @cullinan_jewellery.bg за нови модели и снимки от работата в ателието.",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Social band"
    }
  ]
}
{% endschema %}
