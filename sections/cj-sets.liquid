{%- comment -%}
  The Комплекти page as sets (2026-11-09, owner). The sets are found from the page's own products: each product's
  custom.komplekt metafield names its set's collection, and each set is drawn once (snippets/cj-set-card.liquid).
  So nothing extra is entered in the admin. Products with no set do not appear while sets exist.

  Sits between the banner and the product grid in templates/collection.json and shows only on the collection whose
  handle is in the settings. With at least one set it hides the next section (the product grid and its filters); with
  none it prints nothing and the grid stays. `test_collection` is for a temporary test template only.
{%- endcomment -%}
{%- liquid
  assign cj_on = false
  if collection.handle == section.settings.handle
    assign cj_on = true
  endif
  if section.settings.test_collection != blank
    assign cj_on = true
  endif
-%}

{%- if cj_on -%}
  {%- capture cj_cards -%}
    {%- if section.settings.test_collection != blank -%}
      <li>{%- render 'cj-set-card', set: section.settings.test_collection, label: section.settings.all_label -%}</li>
    {%- endif -%}
    {%- assign cj_seen = ',' -%}
    {%- paginate collection.products by 250 -%}
      {%- for p in collection.products -%}
        {%- assign cj_set = p.metafields.custom.komplekt.value -%}
        {%- if cj_set != blank -%}
          {%- assign cj_key = ',' | append: cj_set.id | append: ',' -%}
          {%- unless cj_seen contains cj_key -%}
            {%- assign cj_seen = cj_seen | append: cj_set.id | append: ',' -%}
            <li>{%- render 'cj-set-card', set: cj_set, label: section.settings.all_label -%}</li>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endcapture -%}

  {%- assign cj_cards = cj_cards | strip -%}
  {%- if cj_cards contains 'cj-set-card' -%}
    {{ 'section-cj-sets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cj-set-card.js' | asset_url }}" defer="defer"></script>

    {%- style -%}
      #shopify-section-{{ section.id }} + .shopify-section {
        display: none;
      }

      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | divided_by: 10.0 }}rem;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | divided_by: 10.0 }}rem;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top | divided_by: 10.0 }}rem;
          padding-bottom: {{ section.settings.padding_bottom | divided_by: 10.0 }}rem;
        }
      }
    {%- endstyle -%}

    <div class="page-width section-{{ section.id }}-padding">
      <ul class="cj-sets" role="list">
        {{ cj_cards }}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Sets (cards)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "On the collection named below, shows one card per set instead of the product grid. A product belongs to a set through its metafield custom.komplekt."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Collection handle",
      "default": "комплекти"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Link to the whole set",
      "default": "Вижте комплекта"
    },
    {
      "type": "collection",
      "id": "test_collection",
      "label": "Test collection",
      "info": "Only for testing: drawn as one more set. Leave empty."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ]
}
{% endschema %}
