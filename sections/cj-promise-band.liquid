{{ 'section-promise-band.css' | asset_url | stylesheet_tag }}
<script src="{{ 'promise-band.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Promise band (2026-11-02, owner: „the same one“ as beornare.com's band under the product and on its homepage, „with
  our font and background color“; precious metals and skin, 14 days for return, free delivery by order value).
  Theirs: a full-width warm peach band, three columns, each a thin line icon, a bold capital heading and one light
  line, all centred. Ours: the same arrangement in the site's soft blush (scheme-2), Jost, espresso line icons from
  snippets/icon-benefit.liquid (no circle, unlike the ruby trust row, so the two rows do not look alike). On phones
  the columns stack. Every word and icon is a block setting.
{%- endcomment -%}

<div class="promise-band color-{{ section.settings.color_scheme }} gradient">
  <div
    class="promise-band__inner page-width"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {%- comment -%}
      Phones (2026-11-02, owner: „like in his website the lines down when you swipe“): beornare shows two of the three
      at a time, swiped sideways, with two long thin arrows under them. <promise-slider> (assets/promise-band.js) moves
      the row one item per arrow and greys out the arrow at either end; without it the row still swipes.
    {%- endcomment -%}
    <promise-slider class="promise-band__slider">
    <ul class="promise-band__list" role="list" tabindex="-1">
      {%- for block in section.blocks -%}
        <li class="promise-band__item" {{ block.shopify_attributes }}>
          <span class="promise-band__icon">{% render 'icon-benefit', icon: block.settings.icon %}</span>
          {%- if block.settings.heading != blank -%}
            <h3 class="promise-band__heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="promise-band__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="promise-band__arrows">
      <button type="button" class="promise-band__arrow" data-promise-prev aria-label="Назад">
        <svg viewBox="0 0 44 12" aria-hidden="true" focusable="false"><path d="M43 6H1.5M6.5 1 1.5 6l5 5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="promise-band__arrow" data-promise-next aria-label="Напред">
        <svg viewBox="0 0 44 12" aria-hidden="true" focusable="false"><path d="M1 6h41.5M37.5 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    </promise-slider>
  </div>
</div>

{% schema %}
{
  "name": "Promise band",
  "tag": "section",
  "class": "section section-promise-band",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "gold-bars", "label": "Gold bars (stacked)" },
            { "value": "gold-bar", "label": "Gold bar" },
            { "value": "gem", "label": "Gem" },
            { "value": "ring", "label": "Ring" },
            { "value": "hammer", "label": "Hammer" },
            { "value": "delivery-truck", "label": "Delivery truck" },
            { "value": "delivery-van", "label": "Delivery van" },
            { "value": "box", "label": "Box" },
            { "value": "return-arrow", "label": "Return arrow" },
            { "value": "calendar-14", "label": "Calendar with 14" },
            { "value": "certificate", "label": "Certificate" },
            { "value": "shield", "label": "Shield with tick" },
            { "value": "magnifier", "label": "Magnifier" }
          ],
          "default": "gold-bar"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promise band",
      "blocks": [{ "type": "promise" }, { "type": "promise" }, { "type": "promise" }]
    }
  ]
}
{% endschema %}
