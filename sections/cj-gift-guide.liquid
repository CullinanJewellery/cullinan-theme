{{ 'section-gift-guide.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Gift guide band (2026-10-27, owner: the homepage's zodiac section changed to one like moonmagic.com's „Moon Magic's
  GIFT GUIDE“). Measured there at 1440px: a photograph across the whole width, 570px tall; on its left, in white, a
  two-line heading (65px, the second line the larger idea), a short sentence (22px) and an outlined white button
  (1px white border, 22px capitals, 2.2px tracking, 485 × 72).

  Ours: the same band and layout in Jost (normal letters, the site's headings), the button as theirs (outlined white,
  our capitals and tracking). A soft dark shade on the left keeps the white words readable over any photograph. With
  no photograph yet the band is espresso, so the white words still read and nothing moves once a photograph lands.
  Phones: the photograph at 4:5 with the words over its lower part; a separate phone photograph can be set.
  Every word, the link and the photographs are settings (theme editor → Homepage → Photo band).
  2026-10-27, owner: „this section have to be for zodiac signs“: on the homepage it carries the zodiac words and
  links to the zodiac collection; the section itself stays general (any heading, any link).
{%- endcomment -%}

<div class="gift-guide{% if section.settings.image == blank %} gift-guide--empty{% endif %}">
  <div class="gift-guide__media">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w,
              {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
          >
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'gift-guide__image',
              widths: '900, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'gift-guide__image',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: section.settings.image.alt,
            style: section.settings.image.presentation.focal_point | prepend: 'object-position: '
        }}
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="gift-guide__inner page-width">
    <div class="gift-guide__content">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <h2 class="gift-guide__heading">
          {%- if section.settings.eyebrow != blank -%}
            <span class="gift-guide__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <span class="gift-guide__title">{{ section.settings.heading | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="gift-guide__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- liquid
        comment
          Never a link to an empty collection: a collection link whose collection has no pieces yet shows
          „Очаквайте скоро“ instead of the button, and becomes the button by itself once pieces are added.
        endcomment
        assign cj_band_soon = false
        if section.settings.button_link contains '/collections/'
          assign cj_handle = section.settings.button_link | split: '/collections/' | last | split: '?' | first | split: '/' | first | url_decode
          if cj_handle != 'all' and collections[cj_handle].products_count == 0
            assign cj_band_soon = true
          endif
        endif
      -%}
      {%- if cj_band_soon -%}
        <p class="gift-guide__soon">Очаквайте скоро</p>
      {%- elsif section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="gift-guide__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Photo band",
  "tag": "section",
  "class": "section section-gift-guide",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Wide, about 2400 × 960. The words sit on its left, so keep the jewellery to the right."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Phone photograph (optional)",
      "info": "Upright, about 1200 × 1500. Empty: the photograph above, cropped."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "First line of the heading",
      "default": "Cullinan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Идеи за подарък"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Ръчно изработени бижута от злато и сребро за рожден ден, имен ден, годишнина и всеки специален повод.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Изберете подарък"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Photo band"
    }
  ]
}
{% endschema %}
