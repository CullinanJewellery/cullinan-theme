{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_bg_video = false
  if section.settings.background_video != blank or section.settings.background_video_url != blank
    assign has_bg_video = true
  endif
  assign has_bg_media = has_bg_video
  if section.settings.background_image != blank
    assign has_bg_media = true
  endif
  assign bg_poster = section.settings.background_poster | default: section.settings.background_video.preview_image
  assign bg_video_id = section.settings.background_video_url.id
-%}

<div class="newsletter center {% if section.settings.full_width == false %}newsletter--narrow page-width{% endif %}">
  <div class="newsletter__wrapper newsletter--crown color-{{ section.settings.color_scheme }} gradient content-container isolate{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding{% if has_bg_media %} newsletter--picture{% endif %}"
    {%- if has_bg_media -%}
      style="--newsletter-veil: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    {%- endif -%}
  >
    {%- if has_bg_media -%}
      {%- comment -%}
        Decorative: the heading and text carry the meaning, so the alt is empty,
        same as the Контакти banner and its footer picture (2026-09-15, at the
        owner's request -- a fourth place words sit over an image, see Design
        direction in CLAUDE.md). A background video was added 2026-09-16, at the
        owner's request, the same Shopify-hosted-or-YouTube/Vimeo choice as the
        homepage atelier blocks (sections/atelier.liquid) -- see the reduced-motion
        script below, which follows that same section's own pattern.
      {%- endcomment -%}
      <div class="newsletter__media">
        {%- if section.settings.background_video != blank -%}
          {%- if bg_poster != blank -%}
            {{
              bg_poster
              | image_url: width: 3000
              | image_tag:
                class: 'newsletter__media-poster',
                widths: '750, 1100, 1500, 1920, 2400, 3000',
                sizes: '100vw',
                alt: '',
                loading: 'lazy'
            }}
          {%- endif -%}
          <video
            class="newsletter__media-motion"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            {% if bg_poster != blank %}
              poster="{{ bg_poster | image_url: width: 1920 }}"
            {% endif %}
            aria-hidden="true"
            tabindex="-1"
          >
            {%- for source in section.settings.background_video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- elsif section.settings.background_video_url != blank -%}
          {%- if bg_poster != blank -%}
            {{
              bg_poster
              | image_url: width: 3000
              | image_tag:
                class: 'newsletter__media-poster',
                widths: '750, 1100, 1500, 1920, 2400, 3000',
                sizes: '100vw',
                alt: '',
                loading: 'lazy'
            }}
          {%- endif -%}
          {%- if section.settings.background_video_url.type == 'youtube' -%}
            <iframe
              class="newsletter__media-motion"
              src="https://www.youtube.com/embed/{{ bg_video_id }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ bg_video_id }}&playsinline=1&modestbranding=1"
              allow="autoplay; encrypted-media"
              aria-hidden="true"
              tabindex="-1"
              title=""
            ></iframe>
          {%- else -%}
            <iframe
              class="newsletter__media-motion"
              src="https://player.vimeo.com/video/{{ bg_video_id }}?autoplay=1&muted=1&loop=1&background=1"
              allow="autoplay; encrypted-media"
              aria-hidden="true"
              tabindex="-1"
              title=""
            ></iframe>
          {%- endif -%}
        {%- else -%}
          {{
            section.settings.background_image
            | image_url: width: 3000
            | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: '100vw', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'heading' -%}
          <h2
            class="inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'paragraph' -%}
          <div
            class="newsletter__subheading rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.text }}
          </div>
        {%- when 'email_form' -%}
          <div {{ block.shopify_attributes }}>
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div
                class="newsletter-form__field-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="newsletter-form__row">
                  <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                  </div>
                  <button
                    type="submit"
                    class="newsletter-form__button field__button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                  >
                    {%- if section.settings.button_label != blank -%}

                      <span class="newsletter-form__button-label">{{ section.settings.button_label | escape }}</span>

                    {%- else -%}

                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>

                    {%- endif -%}
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
              {%- if section.settings.footnote != blank -%}

                <p class="newsletter__footnote">{{ section.settings.footnote | escape }}</p>

              {%- endif -%}

            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- if has_bg_video -%}
  <script>
    // The footage is decorative. Under prefers-reduced-motion nothing plays:
    // the element is removed outright and the poster still is what remains.
    // Same pattern as sections/atelier.liquid.
    (function () {
      if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var section = document.currentScript.previousElementSibling;
      if (!section) return;
      section.querySelectorAll('.newsletter__media-motion').forEach(function (el) {
        el.remove();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Абонирайте се",
      "info": "Leave empty to show the arrow instead."
      },
    {
      "type": "text",
      "id": "footnote",
      "label": "Note under the form",
      "default": "Отписвате се с едно кликване.",
      "info": "Hidden when empty."
      },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.newsletter.settings.full_width.label"
    },
    {
      "type": "paragraph",
      "content": "Covers the black band, with the heading, text and form over it. A video needs a poster image. Leave everything empty and the band stays plain black."
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video"
    },
    {
      "type": "video_url",
      "id": "background_video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Or an external video URL"
    },
    {
      "type": "image_picker",
      "id": "background_poster",
      "label": "Poster image for the video",
      "info": "Required with a video. Also what is shown when the visitor prefers reduced motion."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Or a background picture",
      "info": "Used when no video is set. Empty by default -- upload your own."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Veil over the picture or video",
      "info": "Black, laid over it, for when the words need help.",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.newsletter.blocks.heading.settings.heading.default",
          "label": "t:sections.newsletter.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.newsletter.blocks.paragraph.settings.paragraph.default",
          "label": "t:sections.newsletter.blocks.paragraph.settings.paragraph.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
