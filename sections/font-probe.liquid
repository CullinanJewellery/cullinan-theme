{%- comment -%}
  Temporary diagnostic, not used by any template. Rendered only through the
  Section Rendering API (?section_id=font-probe) to read the real Shopify-hosted
  file of each candidate font, so its Cyrillic coverage can be tested before a
  font is offered to the owner. Shopify's copy of Jost carried no Cyrillic even
  though the original does. Delete once the fonts are chosen.
{%- endcomment -%}
<style>
  {{ section.settings.f1 | font_face }}
  {{ section.settings.f2 | font_face }}
  {{ section.settings.f3 | font_face }}
  {{ section.settings.f4 | font_face }}
  {{ section.settings.f5 | font_face }}
  {{ section.settings.f6 | font_face }}
  {{ section.settings.f7 | font_face }}
  {{ section.settings.f8 | font_face }}
  {{ section.settings.f9 | font_face }}
  {{ section.settings.f10 | font_face }}
</style>
<div class="font-probe" data-families="{{ section.settings.f1.family }}|{{ section.settings.f2.family }}|{{ section.settings.f3.family }}|{{ section.settings.f4.family }}|{{ section.settings.f5.family }}|{{ section.settings.f6.family }}|{{ section.settings.f7.family }}|{{ section.settings.f8.family }}|{{ section.settings.f9.family }}|{{ section.settings.f10.family }}"></div>

{% schema %}
{
  "name": "Font probe",
  "settings": [
    { "type": "font_picker", "id": "f1", "label": "1", "default": "cormorant_n5" },
    { "type": "font_picker", "id": "f2", "label": "2", "default": "ebgaramond_n4" },
    { "type": "font_picker", "id": "f3", "label": "3", "default": "oranienbaum_n4" },
    { "type": "font_picker", "id": "f4", "label": "4", "default": "tenor_sans_n4" },
    { "type": "font_picker", "id": "f5", "label": "5", "default": "manrope_n4" },
    { "type": "font_picker", "id": "f6", "label": "6", "default": "inter_n4" },
    { "type": "font_picker", "id": "f7", "label": "7", "default": "source_sans_pro_n4" },
    { "type": "font_picker", "id": "f8", "label": "8", "default": "lora_n4" },
    { "type": "font_picker", "id": "f9", "label": "9", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "f10", "label": "10", "default": "montserrat_n4" }
  ]
}
{% endschema %}
