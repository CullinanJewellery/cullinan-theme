{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

{%- comment -%}
  Cullinan (2026-10-07, owner): a picture behind the whole heading area (breadcrumb and title),
  the same height as before, words in place over it. Per collection: a „custom.heading_image“
  metafield if the shop defines one, otherwise the collection's own image (Shopify admin →
  the collection → Image). Without either, the plain area as before, no broken image.
  Cropped to cover, around the image's focal point; a soft dark veil keeps the white words
  readable (assets/crown.css, „Collection heading picture“).
{%- endcomment -%}
{%- liquid
  assign cj_hero_image = collection.metafields.custom.heading_image.value | default: collection.image
  if cj_hero_image != blank and cj_hero_image.width == blank
    assign cj_hero_image = collection.image
  endif
  comment
    „Всички бижута“ (/collections/all) is Shopify's built-in all-products list, not a collection
    with its own image or title, so its picture and, if wished, its heading come from this
    section's settings (theme editor → collection page → Collection banner).
  endcomment
  assign cj_hero_title = collection.title
  if collection.handle == 'all'
    if cj_hero_image == blank and section.settings.all_image != blank
      assign cj_hero_image = section.settings.all_image
    endif
    if section.settings.all_title != blank
      assign cj_hero_title = section.settings.all_title
    endif
  endif
  assign cj_hero_focal = 'object-position: ' | append: cj_hero_image.presentation.focal_point
  comment
    2026-11-23 (owner): the twelve zodiac collections and „Зодии“ get their own heading layout
    (crown.css „Zodiac collections: heading“): the three qualities always in one row, centred on phones.
  endcomment
  assign cj_zodiac_handles = 'зодии,овен,телец,близнаци,рак,лъв,дева,везни,скорпион,стрелец,козирог,водолей,риби' | split: ','
  assign cj_is_zodiac = false
  if cj_zodiac_handles contains collection.handle
    assign cj_is_zodiac = true
  endif
-%}
{%- capture cj_stone_colour -%}{%- render 'cj-menu-stone', handle: collection.handle, part: 'colour' -%}{%- endcapture -%}
{%- comment -%}
  2026-11-23 (owner): the quality dots and the bold words of the description take a colour linked with the collection
  (crown.css „Collection colour: dots and bold words“). Zodiac signs: the colour usually linked with the sign; faith
  collections: Marian blue, icon gold, Orthodox crimson, the thread's red; „с перли“ / „с циркони“: the stone's colour
  (snippets/cj-menu-stone.liquid). Every colour is dark enough to read as text on the heading's greige (at least
  4.5:1 on #F5F3EF): the light sign colours (yellow, silver, orange, pink …) are their hue made darker.
{%- endcomment -%}
{%- liquid
  case collection.handle
    when 'овен'
      assign cj_stone_colour = '#b3362f'
    when 'телец'
      assign cj_stone_colour = '#4a7747'
    when 'близнаци'
      assign cj_stone_colour = '#856b1a'
    when 'рак'
      assign cj_stone_colour = '#616d7b'
    when 'лъв'
      assign cj_stone_colour = '#a15b1e'
    when 'дева'
      assign cj_stone_colour = '#776d32'
    when 'везни'
      assign cj_stone_colour = '#8d616d'
    when 'скорпион'
      assign cj_stone_colour = '#6e1f3c'
    when 'стрелец'
      assign cj_stone_colour = '#6b4194'
    when 'козирог'
      assign cj_stone_colour = '#6a5444'
    when 'водолей'
      assign cj_stone_colour = '#287397'
    when 'риби'
      assign cj_stone_colour = '#347970'
    when 'богородици'
      assign cj_stone_colour = '#2f4f8a'
    when 'вяра-и-закрила'
      assign cj_stone_colour = '#88692d'
    when 'кръстове'
      assign cj_stone_colour = '#7d2a35'
    when 'гривни-с-червен-конец'
      assign cj_stone_colour = '#b0242f'
    when 'висулки-с-перли', 'обеци-с-перли', 'пръстени-с-перли', 'комплекти-с-перли'
      assign cj_stone_colour = '#7e6b53'
    when 'висулки-с-циркони', 'обеци-с-циркони', 'пръстени-с-циркони', 'комплекти-с-циркони', 'гривни-с-циркони'
      assign cj_stone_colour = '#596f81'
  endcase
-%}
<div{% if cj_stone_colour != blank %} style="--cj-stone-colour: {{ cj_stone_colour }};"{% endif %} class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %}{% if cj_hero_image != blank %} cj-hero--image{% endif %}{% if cj_is_zodiac %} cj-hero--zodiac{% endif %} color-{{ section.settings.color_scheme }} gradient">
  {%- if cj_hero_image != blank -%}
    {{
      cj_hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'cj-hero__bg',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: '',
        style: cj_hero_focal
    }}
  {%- endif -%}
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- comment -%} No „Начало › the collection“ trail since 2026-10-21 (owner: more room for the title and text, and for a heading picture); it was above the title from 2026-10-05. {%- endcomment -%}
      {%- comment -%} The collection's name alone, „Пръстени“ (2026-10-07, owner; „Колекция:“ was a hidden prefix). {%- endcomment -%}
      {%- comment -%}
        2026-10-21 (owner, as moonmagic.com's „MOONSTONE Intuition“): a stone collection's meaning beside its name,
        in italic, in the stone's colour (snippets/cj-menu-stone.liquid, the same words as the menu and the homepage
        stones). The text under it is the collection's own Description in Shopify admin.
      {%- endcomment -%}
      {%- comment -%} Christmas (2026-11-19, experiments theme only): the hero's „Весела Коледа“ line above the name. {%- endcomment -%}
      <p class="cj-xmas-eyebrow">Весела Коледа</p>
      <h1 class="collection-hero__title">
        <span class="cj-hero__name">{{- cj_hero_title | escape -}}</span>
        {%- render 'cj-menu-stone', handle: collection.handle, part: 'hero' -%}
      </h1>

      {%- if section.settings.show_collection_description -%}
        {%- comment -%}
          2026-10-21 (owner): the three qualities may be typed as lines starting with „•“ (they were, on all six
          stones) instead of with Shopify's list button. Such lines become a real list here, so they take the
          qualities' look (crown.css „Stone collections: the three qualities“). Text without „•“ is printed as it is.
        {%- endcomment -%}
        {%- liquid
          assign cj_desc = collection.description
          if cj_desc contains '•'
            assign cj_parts = cj_desc | split: '•'
            assign cj_intro = cj_parts.first | strip
            for i in (1..3)
              assign cj_tail = cj_intro | slice: -4, 4
              if cj_tail == '<br>'
                assign cj_intro = cj_intro | remove_last: '<br>' | strip
              endif
              assign cj_tail = cj_intro | slice: -3, 3
              if cj_tail == '<p>'
                assign cj_intro = cj_intro | remove_last: '<p>' | strip
              endif
            endfor
            assign cj_tail = cj_intro | slice: -4, 4
            if cj_intro contains '<p' and cj_tail != '</p>'
              assign cj_intro = cj_intro | append: '</p>'
            endif
            capture cj_items
              for part in cj_parts offset: 1
                assign cj_item = part | strip_html | strip
                if cj_item != blank
                  echo '<li>' | append: cj_item | append: '</li>'
                endif
              endfor
            endcapture
            assign cj_desc = cj_intro | append: '<ul>' | append: cj_items | append: '</ul>'
          endif
        -%}
        <div class="collection-hero__description rte">{%- render 'cj-metals', text: cj_desc -%}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "„Всички бижута“ (all products)"
    },
    {
      "type": "paragraph",
      "content": "Every collection uses its own image (Shopify admin → the collection → Image) behind its heading. The all-products page has none, so its picture is chosen here."
    },
    {
      "type": "image_picker",
      "id": "all_image",
      "label": "Heading picture for all products"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Heading for all products",
      "info": "Empty: Shopify's own name for the page."
    }
  ]
}
{% endschema %}
