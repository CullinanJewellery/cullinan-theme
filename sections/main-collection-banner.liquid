{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

{%- comment -%}
  Cullinan (2026-10-07, owner): a picture behind the whole heading area (breadcrumb and title),
  the same height as before, words in place over it. Per collection: a „custom.heading_image“
  metafield if the shop defines one, otherwise the collection's own image (Shopify admin →
  the collection → Image). Without either, the plain area as before, no broken image.
  Cropped to cover, around the image's focal point; a soft dark veil keeps the white words
  readable (assets/crown.css, „Collection heading picture“).
{%- endcomment -%}
{%- liquid
  assign cj_hero_image = collection.metafields.custom.heading_image.value | default: collection.image
  if cj_hero_image != blank and cj_hero_image.width == blank
    assign cj_hero_image = collection.image
  endif
  comment
    „Всички бижута“ (/collections/all) is Shopify's built-in all-products list, not a collection
    with its own image or title, so its picture and, if wished, its heading come from this
    section's settings (theme editor → collection page → Collection banner).
  endcomment
  assign cj_hero_title = collection.title
  if collection.handle == 'all'
    if cj_hero_image == blank and section.settings.all_image != blank
      assign cj_hero_image = section.settings.all_image
    endif
    if section.settings.all_title != blank
      assign cj_hero_title = section.settings.all_title
    endif
  endif
  assign cj_hero_focal = 'object-position: ' | append: cj_hero_image.presentation.focal_point
-%}
<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %}{% if cj_hero_image != blank %} cj-hero--image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  {%- if cj_hero_image != blank -%}
    {{
      cj_hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'cj-hero__bg',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: '',
        style: cj_hero_focal
    }}
  {%- endif -%}
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- comment -%} Cullinan (2026-10-05): Начало › the collection, above the title. {%- endcomment -%}
      {% render 'breadcrumbs', current: cj_hero_title %}
      {%- comment -%} The collection's name alone, „Пръстени“ (2026-10-07, owner; „Колекция:“ was a hidden prefix). {%- endcomment -%}
      <h1 class="collection-hero__title">
        {{- cj_hero_title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "„Всички бижута“ (all products)"
    },
    {
      "type": "paragraph",
      "content": "Every collection uses its own image (Shopify admin → the collection → Image) behind its heading. The all-products page has none, so its picture is chosen here."
    },
    {
      "type": "image_picker",
      "id": "all_image",
      "label": "Heading picture for all products"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Heading for all products",
      "info": "Empty: Shopify's own name for the page."
    }
  ]
}
{% endschema %}
