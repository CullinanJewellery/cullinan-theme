{{ 'section-review-cards.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Customer reviews on the homepage: „Отзиви от наши клиенти“.

  Since 2026-10-05 the reviews come only from Judge.me (the owner: real, published
  reviews, one source with the hero rating). The theme cannot list individual
  Judge.me reviews itself -- Judge.me gives the theme only the shop-wide average and
  count as metafields -- so the reviews are drawn by a Judge.me widget placed in this
  section as an app block (Judge.me's Cards or Testimonials carousel, both on its free
  plan). App blocks can only be added in the theme editor: Customize -> Home page ->
  this section -> Add block -> Judge.me.

  The section prints nothing to shoppers until Judge.me reports at least one
  published review (shop.metafields.judgeme.all_reviews_count, the same count as the
  hero line) and a Judge.me block is in place. In the theme editor it always shows,
  with a note saying what is missing. The earlier hand-filled review cards and their
  draft-only samples are gone. Our heading and eyebrow stay; the widget's own look is
  styled in assets/crown.css where Judge.me's classes allow (fails soft).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-margin {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-margin {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign jm_count = shop.metafields.judgeme.all_reviews_count | plus: 0
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor

  assign show_section = false
  if request.design_mode
    assign show_section = true
  elsif jm_count > 0
    if app_count > 0
      assign show_section = true
    endif
  endif
-%}

{%- if show_section -%}
  <div class="review-cards color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-margin" id="otzivi">
    <div class="review-cards__inner page-width section-{{ section.id }}-padding">
      <div class="review-cards__header">
        <div class="review-cards__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="review-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="review-cards__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      </div>

      {%- if request.design_mode -%}
        {%- if app_count == 0 -%}
          <p class="review-cards__note">
            Само в редактора: добавете блок от Judge.me (Cards carousel или Testimonials carousel) в тази секция.
          </p>
        {%- endif -%}
        {%- if jm_count == 0 -%}
          <p class="review-cards__note">
            Само в редактора: все още няма публикувани отзиви в Judge.me, затова секцията е скрита за посетителите.
          </p>
        {%- endif -%}
      {%- endif -%}

      <div class="review-cards__app">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Real, published Judge.me reviews only. Add a Judge.me block (Cards carousel or Testimonials carousel) to this section. Visitors see the section only when Judge.me has at least one published review."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Отзиви",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Отзиви от наши клиенти",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Unused",
      "info": "No longer shown; the rating comes from Judge.me."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Colour scheme"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "default": "scheme-6",
      "label": "Card colour scheme",
      "info": "Kept for compatibility; Judge.me draws its own cards."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    {
      "type": "header",
      "content": "Space outside"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
