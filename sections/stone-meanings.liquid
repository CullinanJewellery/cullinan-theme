{{ 'section-stone-meanings.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The stones, each with a word for what it is.

  After moonmagic's own "DESIGNED TO MEAN MORE" row, measured there: a picture of
  the loose stone, a meaning in capitals above the stone's name, each linking to
  that stone's own collection. Theirs is a Swiper carousel because they carry
  eighteen stones; ours is a plain wrapping row, because six fit on one line and
  a row that holds still reads calmer than one that moves -- see "Restraint reads
  as expensive" in CLAUDE.md.

  A stone with no link renders as a tile rather than a link, so the section can
  ship before the stone collections exist. Never link to an empty collection.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  .section-{{ section.id }}-margin {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-margin {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  The margin goes on this outer div, the one that paints the band, and the
  padding on the inner one -- the same split the atelier bands use. Padding here
  would only make the greige taller; it is the margin that lets the page's own
  ground show above and below, which is what reads as space between sections.
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-margin">
  <div class="stones page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="stones__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        The viewport is a plain block on a computer, where the grid lays out six
        across and nothing scrolls. On a phone it becomes the row moonmagic has:
        the track between two arrows, swiped with a finger or stepped with them.
        The arrows are hidden above 750px and carry aria-hidden until the script
        finds a track that actually overflows, so a keyboard never reaches a
        control that does nothing.
      {%- endcomment -%}
      <div class="stones__viewport">
        <button
          type="button"
          class="stones__arrow stones__arrow--prev"
          aria-label="{{ 'sections.slider.previous_slide' | t | default: 'Предишни' }}"
          aria-controls="StonesTrack-{{ section.id }}"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

      <ul class="stones__grid" id="StonesTrack-{{ section.id }}" role="list">
        {%- for block in section.blocks -%}
          <li class="stones__item" {{ block.shopify_attributes }}>
            {%- capture stone_tile -%}
              <span class="stones__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      class: 'stones__image',
                      loading: 'lazy',
                      widths: '200, 300, 400, 600',
                      sizes: '(min-width: 990px) 200px, (min-width: 750px) 30vw, 42vw',
                      alt: block.settings.image.alt | default: block.settings.name
                  }}
                {%- else -%}
                  <span class="stones__image stones__image--empty"></span>
                {%- endif -%}
              </span>
              {%- if block.settings.meaning != blank -%}
                <span class="stones__meaning">{{ block.settings.meaning | escape }}</span>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <span class="stones__name">{{ block.settings.name | escape }}</span>
              {%- endif -%}
            {%- endcapture -%}

            {%- if block.settings.link != blank -%}
              <a class="stones__tile" href="{{ block.settings.link }}">{{ stone_tile }}</a>
            {%- else -%}
              <span class="stones__tile">{{ stone_tile }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

        <button
          type="button"
          class="stones__arrow stones__arrow--next"
          aria-label="{{ 'sections.slider.next_slide' | t | default: 'Следващи' }}"
          aria-controls="StonesTrack-{{ section.id }}"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- comment -%}
      moonmagic closes this row with FIND YOUR STONE, centred under the stones.
      Ours is sized to match Вижте всички under Най-продавани instead of to theirs:
      same page, same job, and the owner already tuned that one.

      It renders only when it has somewhere to go -- structure can exist before
      content, navigation cannot.
    {%- endcomment -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="stones__cta">
        <a class="stones__button button button--primary" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  The arrows. The track is a plain CSS scroll container, so a finger already
  works with no script at all -- this only adds the two buttons for anyone who
  would rather tap than swipe, and reveals them only when the track really does
  overflow, which on a computer it never does.

  Scrolls by one item plus its gap, measured off the live elements rather than
  hardcoded, so it keeps stepping correctly if the item width is ever retuned.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.stones__grid');
    var prev = root.querySelector('.stones__arrow--prev');
    var next = root.querySelector('.stones__arrow--next');
    if (!track || !prev || !next) return;

    var items = [].slice.call(track.querySelectorAll('.stones__item'));
    if (!items.length) return;

    function scrollable() {
      return track.scrollWidth - track.clientWidth > 1;
    }

    // Which stone is nearest the middle of the track right now. The scaling is
    // keyed off this rather than off a scroll position, so a finger and the
    // arrows land on exactly the same answer.
    function centredIndex() {
      var middle = track.scrollLeft + track.clientWidth / 2;
      var best = 0;
      var bestGap = Infinity;
      items.forEach(function (item, i) {
        var gap = Math.abs(item.offsetLeft + item.offsetWidth / 2 - middle);
        if (gap < bestGap) {
          bestGap = gap;
          best = i;
        }
      });
      return best;
    }

    function update() {
      var on = scrollable();
      [prev, next].forEach(function (button) {
        button.hidden = !on;
      });
      if (!on) {
        items.forEach(function (item) { item.classList.remove('stones__item--centred'); });
        return;
      }
      var centre = centredIndex();
      items.forEach(function (item, i) {
        item.classList.toggle('stones__item--centred', i === centre);
      });
    }

    // moonmagic runs Swiper with loop: true, so their arrows never stop -- the
    // one after the last stone is the first again. Ours wraps the same way
    // rather than disabling at an end.
    function go(direction) {
      var target = (centredIndex() + direction + items.length) % items.length;
      var item = items[target];
      var left = item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2;
      var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
      // Scroll events are frame-driven, so mark the new centre straight away
      // rather than waiting for one to arrive.
      items.forEach(function (el, i) {
        el.classList.toggle('stones__item--centred', i === target);
      });
    }

    prev.addEventListener('click', function () { go(-1); });
    next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', update, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(track);
    window.addEventListener('resize', update);

    update();
  })();
</script>

{% schema %}
{
  "name": "Stones",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Всеки камък има значение"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Открийте своя камък"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "The button stays hidden until a destination is set."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above the band",
      "info": "Page background above the coloured band, so it does not touch the section above it.",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below the band",
      "default": 40
    },
    {
      "type": "header",
      "content": "Padding inside the band"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Stone",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture of the stone",
          "info": "Leave empty until the photography exists — a flat tile is shown."
        },
        {
          "type": "text",
          "id": "meaning",
          "label": "Word above the name",
          "info": "One word. Printed in capitals."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Stone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty until that stone's collection exists and has products in it. Without a destination the tile is shown but is not a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stones",
      "blocks": [
        { "type": "stone", "settings": { "meaning": "Блясък", "name": "Циркон" } },
        { "type": "stone", "settings": { "meaning": "Завинаги", "name": "Диамант" } },
        { "type": "stone", "settings": { "meaning": "Класика", "name": "Перла" } },
        { "type": "stone", "settings": { "meaning": "Дълбочина", "name": "Сапфир" } },
        { "type": "stone", "settings": { "meaning": "Страст", "name": "Рубин" } },
        { "type": "stone", "settings": { "meaning": "Рядкост", "name": "Изумруд" } }
      ]
    }
  ]
}
{% endschema %}
