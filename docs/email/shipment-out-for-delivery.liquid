{%- comment -%}
  Out for delivery.
  Generated by tools/email-templates.mjs (cj-brand v2). Way back: "Revert to -> Default" on the preview page.
{%- endcomment -%}
{%- capture email_title -%}Пратката ви пристига днес{%- endcapture -%}
<!DOCTYPE html>
<html lang="bg">
<head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap" rel="stylesheet">
  <style>
    /* cj-brand v2 */
    body { margin: 0; padding: 0; background: #F5F3EF; }
    a { color: #2A1E1A; }
    @media (max-width: 520px) {
      .cj-pad { padding-left: 22px !important; padding-right: 22px !important; }
      .cj-col { display: block !important; width: 100% !important; max-width: 100% !important; padding: 0 0 18px !important; }
      .cj-title { font-size: 23px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#F5F3EF;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F5F3EF;border-collapse:collapse;">
<tr><td align="center" style="padding:28px 10px;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#FFFFFF;border-collapse:collapse;">

  <tr><td align="center" class="cj-pad" style="padding:36px 40px 26px;">
    {%- if shop.email_logo_url -%}
      <a href="{{ shop.url }}"><img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 170 }}" style="display:block;border:0;max-width:100%;height:auto;"></a>
    {%- else -%}
      <a href="{{ shop.url }}" style="font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;color:#2A1E1A;text-decoration:none;">{{ shop.name }}</a>
    {%- endif -%}
  </td></tr>
  <tr><td class="cj-pad" style="padding:0 40px;"><div style="height:1px;line-height:1px;font-size:1px;background:#D6C3A1;">&nbsp;</div></td></tr>

  <tr><td align="center" class="cj-pad" style="padding:34px 40px 8px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#9A7A45;">Поръчка {{ order_name }}</p>
    <h1 class="cj-title" style="margin:12px 0 0;font-size:26px;line-height:1.25;font-weight:500;color:#2A1E1A;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">{{ email_title }}</h1>
    <p style="margin:14px auto 0;max-width:400px;font-size:15px;line-height:1.6;color:#4A3C37;">Куриерът е тръгнал към адреса за доставка с вашата пратка.</p>
    {%- if fulfillment.tracking_numbers.first -%}
      <p style="margin:12px 0 0;font-size:14px;color:#7A6A64;">{% if fulfillment.tracking_company %}{{ fulfillment.tracking_company }} · {% endif %}номер на пратката: <span style="color:#2A1E1A;">{{ fulfillment.tracking_numbers.first }}</span></p>
    {%- endif -%}
    {%- if fulfillment.estimated_delivery_at -%}
      <p style="margin:6px 0 0;font-size:14px;color:#7A6A64;">Очаквана доставка: <span style="color:#2A1E1A;">{{ fulfillment.estimated_delivery_at | date: format: 'date' }}</span></p>
    {%- endif -%}{%- if fulfillment.tracking_urls.first -%}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:26px auto 6px;border-collapse:collapse;">
      <tr><td align="center" bgcolor="#000000" style="background:#000000;">
        <a href="{{ fulfillment.tracking_urls.first }}" style="display:inline-block;padding:15px 34px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#FFFFFF;text-decoration:none;">Проследете пратката</a>
      </td></tr>
    </table>{%- elsif order_status_url -%}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:26px auto 6px;border-collapse:collapse;">
      <tr><td align="center" bgcolor="#000000" style="background:#000000;">
        <a href="{{ order_status_url }}" style="display:inline-block;padding:15px 34px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#FFFFFF;text-decoration:none;">Вижте поръчката</a>
      </td></tr>
    </table>{%- endif -%}
  </td></tr>

  <tr><td class="cj-pad" style="padding:26px 40px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    <p style="margin:0 0 4px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">В пратката</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border-top:1px solid #EADFD8;">
    {%- for line in fulfillment.fulfillment_line_items -%}
      <tr>
        <td width="74" valign="top" style="padding:14px 0;border-bottom:1px solid #EADFD8;width:74px;">
          {%- if line.line_item.image -%}
            <img src="{{ line.line_item | img_url: 'compact_cropped' }}" width="64" height="64" alt="" style="display:block;border:1px solid #EADFD8;background:#FCFBFC;">
          {%- else -%}
            <div style="width:64px;height:64px;border:1px solid #EADFD8;background:#FCFBFC;"></div>
          {%- endif -%}
        </td>
        <td valign="top" style="padding:14px 10px;border-bottom:1px solid #EADFD8;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
          <p style="margin:0;font-size:15px;font-weight:500;color:#2A1E1A;">{{ line.line_item.product.title | default: line.line_item.title }}{% if line.quantity > 1 %} × {{ line.quantity }}{% endif %}</p>
          {%- if line.line_item.variant.title != blank and line.line_item.variant.title != 'Default Title' -%}
            <p style="margin:3px 0 0;font-size:13px;line-height:1.45;color:#7A6A64;">{{ line.line_item.variant.title }}</p>
          {%- endif -%}
          {%- for p in line.line_item.properties -%}
            {%- assign first_char = p.first | slice: 0 -%}
            {%- unless p.last == blank or first_char == '_' -%}
              <p style="margin:3px 0 0;font-size:13px;color:#7A6A64;">{{ p.first }}: {{ p.last }}</p>
            {%- endunless -%}
          {%- endfor -%}
        </td>
      </tr>
    {%- endfor -%}
    </table>
  </td></tr>

  <tr><td class="cj-pad" style="padding:26px 40px 8px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    {%- if shipping_address -%}
    <div class="cj-col" style="display:inline-block;width:48%;max-width:236px;vertical-align:top;padding-right:10px;">
      <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">Доставка до</p>
      <div style="margin:8px 0 0;font-size:14px;line-height:1.6;color:#4A3C37;">{{ shipping_address | format_address | replace: "<p>", "" | replace: "</p>", "" }}</div>
    </div>
    {%- endif -%}
    <div class="cj-col" style="display:inline-block;width:48%;max-width:236px;vertical-align:top;">
      <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">Опаковка</p>
      <p style="margin:8px 0 0;font-size:14px;line-height:1.6;color:#4A3C37;">Всяко бижу пристига в кутия, с индивидуален сертификат.</p>
    </div>
  </td></tr>

  <tr><td style="height:34px;line-height:34px;font-size:1px;">&nbsp;</td></tr>
  <tr><td align="center" bgcolor="#E3CAC2" class="cj-pad" style="background:#E3CAC2;padding:26px 40px 28px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;color:#2A1E1A;">
    <p style="margin:0;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#2A1E1A;">Ръчна изработка от 1991</p>
    <p style="margin:8px 0 0;font-size:13px;color:#5A4A44;">Ателие във Велико Търново</p>
    <p style="margin:14px 0 0;font-size:13px;color:#2A1E1A;">Въпроси? Просто отговорете на този имейл.</p>
    <p style="margin:14px 0 0;font-size:12px;letter-spacing:0.12em;">
      <a href="https://www.instagram.com/cullinan_jewellery.bg/" style="color:#2A1E1A;text-decoration:none;">INSTAGRAM</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.facebook.com/profile.php?id=61573474292352" style="color:#2A1E1A;text-decoration:none;">FACEBOOK</a>
    </p>
  </td></tr>

</table>

</td></tr>
</table>
</body>
</html>
