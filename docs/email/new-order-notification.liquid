{%- comment -%}
  Staff new order: customer, pieces with stock, totals, delivery; link to the order in admin.
  Generated by tools/email-templates.mjs (cj-brand v2). Way back: "Revert to -> Default" on the preview page.
{%- endcomment -%}
{%- capture email_title -%}Нова поръчка {{ name }}{%- endcapture -%}
<!DOCTYPE html>
<html lang="bg">
<head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap" rel="stylesheet">
  <style>
    /* cj-brand v2 */
    body { margin: 0; padding: 0; background: #F5F3EF; }
    a { color: #2A1E1A; }
    @media (max-width: 520px) {
      .cj-pad { padding-left: 22px !important; padding-right: 22px !important; }
      .cj-col { display: block !important; width: 100% !important; max-width: 100% !important; padding: 0 0 18px !important; }
      .cj-title { font-size: 23px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#F5F3EF;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F5F3EF;border-collapse:collapse;">
<tr><td align="center" style="padding:28px 10px;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#FFFFFF;border-collapse:collapse;">

  <tr><td align="center" class="cj-pad" style="padding:36px 40px 26px;">
    {%- if shop.email_logo_url -%}
      <a href="{{ shop.url }}"><img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 170 }}" style="display:block;border:0;max-width:100%;height:auto;"></a>
    {%- else -%}
      <a href="{{ shop.url }}" style="font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;color:#2A1E1A;text-decoration:none;">{{ shop.name }}</a>
    {%- endif -%}
  </td></tr>
  <tr><td class="cj-pad" style="padding:0 40px;"><div style="height:1px;line-height:1px;font-size:1px;background:#D6C3A1;">&nbsp;</div></td></tr>

  <tr><td align="center" class="cj-pad" style="padding:34px 40px 8px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#9A7A45;">За екипа</p>
    <h1 class="cj-title" style="margin:12px 0 0;font-size:26px;line-height:1.25;font-weight:500;color:#2A1E1A;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">{{ email_title }}</h1>
    
    <p style="margin:10px 0 0;font-size:15px;color:#4A3C37;">{% if customer.name %}{{ customer.name }}{% else %}Нов клиент{% endif %} · {{ total_price | money }}</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:26px auto 6px;border-collapse:collapse;">
      <tr><td align="center" bgcolor="#000000" style="background:#000000;">
        <a href="https://{{ shop.permanent_domain }}/admin/orders/{{ id }}" style="display:inline-block;padding:15px 34px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#FFFFFF;text-decoration:none;">Отворете поръчката</a>
      </td></tr>
    </table>
  </td></tr>

  <tr><td class="cj-pad" style="padding:26px 40px 0;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    <p style="margin:0 0 4px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">Бижута</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border-top:1px solid #EADFD8;">
    {%- for line in line_items -%}
      <tr>
        <td width="74" valign="top" style="padding:14px 0;border-bottom:1px solid #EADFD8;width:74px;">
          {%- if line.image -%}
            <img src="{{ line | img_url: 'compact_cropped' }}" width="64" height="64" alt="" style="display:block;border:1px solid #EADFD8;background:#FCFBFC;">
          {%- else -%}
            <div style="width:64px;height:64px;border:1px solid #EADFD8;background:#FCFBFC;"></div>
          {%- endif -%}
        </td>
        <td valign="top" style="padding:14px 10px;border-bottom:1px solid #EADFD8;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
          <p style="margin:0;font-size:15px;font-weight:500;color:#2A1E1A;">{{ line.product.title | default: line.title }}{% if line.quantity > 1 %} × {{ line.quantity }}{% endif %}</p>
          {%- if line.variant.title != blank and line.variant.title != 'Default Title' -%}
            <p style="margin:3px 0 0;font-size:13px;line-height:1.45;color:#7A6A64;">{{ line.variant.title }}</p>
          {%- endif -%}
          {%- for p in line.properties -%}
            {%- assign first_char = p.first | slice: 0 -%}
            {%- unless p.last == blank or first_char == '_' -%}
              <p style="margin:3px 0 0;font-size:13px;color:#7A6A64;">{{ p.first }}: {{ p.last }}</p>
            {%- endunless -%}
          {%- endfor -%}
          {%- if line.sku != blank -%}<p style="margin:3px 0 0;font-size:13px;color:#7A6A64;">Код: {{ line.sku }}</p>{%- endif -%}
          {%- if line.variant.inventory_management == 'shopify' and line.variant.inventory_quantity >= 0 -%}
            <p style="margin:6px 0 0;font-size:12px;letter-spacing:0.04em;color:#9A7A45;">Налично</p>
          {%- elsif line.variant.inventory_management == 'shopify' -%}
            <p style="margin:6px 0 0;font-size:12px;letter-spacing:0.04em;color:#9A7A45;">За изработка</p>
          {%- else -%}
            <p style="margin:6px 0 0;font-size:12px;letter-spacing:0.04em;color:#9A7A45;">Наличността не се следи</p>
          {%- endif -%}
        </td>
        <td valign="top" align="right" style="padding:14px 0;border-bottom:1px solid #EADFD8;white-space:nowrap;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#2A1E1A;">
          {%- if line.original_line_price != line.final_line_price -%}
            <span style="font-size:13px;color:#7A6A64;text-decoration:line-through;">{{ line.original_line_price | money }}</span><br>
          {%- endif -%}
          {{ line.final_line_price | money }}
        </td>
      </tr>
    {%- endfor -%}
    </table>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-top:14px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
      <tr><td style="padding:5px 0;font-size:14px;color:#7A6A64;">Междинна сума</td><td align="right" style="padding:5px 0;font-size:14px;color:#2A1E1A;">{{ subtotal_price | money }}</td></tr>
      {%- for discount_application in discount_applications -%}
        {%- if discount_application.target_type != 'shipping_line' and discount_application.target_selection == 'all' -%}
          <tr><td style="padding:5px 0;font-size:14px;color:#7A6A64;">Отстъпка{% if discount_application.title != blank %} · {{ discount_application.title }}{% endif %}</td><td align="right" style="padding:5px 0;font-size:14px;color:#2A1E1A;">−{{ discount_application.total_allocated_amount | money }}</td></tr>
        {%- endif -%}
      {%- endfor -%}
      {%- if requires_shipping -%}
      <tr><td style="padding:5px 0;font-size:14px;color:#7A6A64;">Доставка</td><td align="right" style="padding:5px 0;font-size:14px;color:#2A1E1A;">{% if shipping_price == 0 %}Безплатна{% else %}{{ shipping_price | money }}{% endif %}</td></tr>
      {%- endif -%}
      {%- if tax_price > 0 -%}
      <tr><td style="padding:5px 0;font-size:14px;color:#7A6A64;">Данъци</td><td align="right" style="padding:5px 0;font-size:14px;color:#2A1E1A;">{{ tax_price | money }}</td></tr>
      {%- endif -%}
      <tr><td colspan="2" style="padding:8px 0 0;"><div style="height:1px;line-height:1px;font-size:1px;background:#EADFD8;">&nbsp;</div></td></tr>
      <tr><td style="padding:10px 0 4px;font-size:17px;font-weight:500;color:#2A1E1A;">Общо</td><td align="right" style="padding:10px 0 4px;font-size:17px;font-weight:500;color:#2A1E1A;">{{ total_price | money_with_currency }}</td></tr>
      {%- assign cj_gateways = transactions | map: 'gateway_display_name' | uniq | join: ', ' -%}
      {%- if cj_gateways != blank -%}
      <tr><td style="padding:5px 0;font-size:14px;color:#7A6A64;">Плащане</td><td align="right" style="padding:5px 0;font-size:14px;color:#2A1E1A;">{{ cj_gateways }}</td></tr>
      {%- endif -%}
    </table>
  </td></tr>

  <tr><td class="cj-pad" style="padding:26px 40px 8px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;">
    <div class="cj-col" style="display:inline-block;width:48%;max-width:236px;vertical-align:top;padding-right:10px;">
      <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">Клиент</p>
      
      <p style="margin:8px 0 0;font-size:14px;line-height:1.6;color:#4A3C37;">{{ customer.name }}{% if email %}<br>{{ email }}{% endif %}{% if shipping_address.phone %}<br>{{ shipping_address.phone }}{% endif %}</p>
      {%- if note != blank -%}<p style="margin:10px 0 0;font-size:14px;line-height:1.6;color:#2A1E1A;">Бележка: {{ note }}</p>{%- endif -%}
    </div>
    {%- if shipping_address -%}
    <div class="cj-col" style="display:inline-block;width:48%;max-width:236px;vertical-align:top;">
      <p style="margin:0;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#2A1E1A;">Доставка до</p>
      <div style="margin:8px 0 0;font-size:14px;line-height:1.6;color:#4A3C37;">{{ shipping_address | format_address | replace: "<p>", "" | replace: "</p>", "" }}</div>
      {%- if shipping_method.title != blank -%}<p style="margin:6px 0 0;font-size:14px;color:#7A6A64;">{{ shipping_method.title }}</p>{%- endif -%}
    </div>
    {%- endif -%}
  </td></tr>

  <tr><td style="height:34px;line-height:34px;font-size:1px;">&nbsp;</td></tr>
  <tr><td align="center" bgcolor="#E3CAC2" class="cj-pad" style="background:#E3CAC2;padding:22px 40px;font-family:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#2A1E1A;">Само за екипа на Cullinan</td></tr>

</table>

</td></tr>
</table>
</body>
</html>
