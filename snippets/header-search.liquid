{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Cullinan (2026-10-21, owner: the search „like theirs“, moonmagic.com): a white bar across the top of the screen
  over the dimmed page — the search icon, one large underlined line to type in, „Изчисти“ and the cross — and under it
  a panel: before typing the popular searches and the bestsellers (sections/cj-search-start, fetched on first open by
  assets/cj-search.js), while typing the results (sections/predictive-search). Dawn's details-modal and
  predictive-search elements stay, so opening, closing, Esc, the arrow keys and the screen-reader announcements work
  as before. The close button must stay the modal's first button[type="button"] (assets/details-modal.js).

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

{%- comment -%} The product cards' own styles, as the homepage rows load them (featured-collection). {%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'cj-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cj-search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'card-swatches.js' | asset_url }}" defer="defer"></script>

<details-modal class="header__search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="search-modal modal__content cj-search"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div class="search-modal__content cj-search__sheet" tabindex="-1">
        <button
          type="button"
          class="search-modal__close-button modal__close-button cj-search__close focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form cj-search__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form cj-search__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="cj-search__bar">
            <span class="cj-search__icon" aria-hidden="true">
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <label class="visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
            <input
              class="search__input cj-search__input"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Бижу, метал или камък"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button cj-search__clear{% if search.terms == blank %} hidden{% endif %}"
            >
              Изчисти
            </button>
          </div>

          <div class="cj-search__start" data-cj-search-start></div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header cj-search__results" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>
