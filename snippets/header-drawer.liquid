{% doc %}
  Renders a header drawer menu for mobile and desktop.

  @param {boolean} [show_country_selector] - Whether to render the country selector in the drawer.
  @param {boolean} [show_language_selector] - Whether to render the language selector in the drawer.
  @param {boolean} [show_social_links] - Whether to render social links list in the drawer.

  @example
  {% render 'header-drawer', show_language_selector: true %}
{% enddoc %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign menu_key = link.title | strip | downcase
                  assign visual_count = 0
                  for block in section.blocks
                    if block.type == 'visual_menu_item'
                      assign block_key = block.settings.menu_item | strip | downcase
                      if block_key == menu_key and block_key != blank
                        assign visual_count = visual_count | plus: 1
                      endif
                    endif
                  endfor
                -%}
                <li>
                  {%- if link.links != blank or visual_count > 0 -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              <svg class="cj-drawer-back" viewBox="0 0 8 16" width="8" height="16" aria-hidden="true" focusable="false"><path d="M7 1 1 8l6 7" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
                            </span>
                            {{ link.title | escape }}
                          </button>
                          {%- if visual_count > 0 -%}

                            {%- render 'header-visual-menu', link: link, section: section, context: 'drawer' -%}

                          {%- else -%}

                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {%- render 'cj-menu-stone', link: childlink, class: 'cj-menu-stone' -%}
                                    <span class="cj-menu-label">{{ childlink.title | escape }}</span>
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          <svg class="cj-drawer-back" viewBox="0 0 8 16" width="8" height="16" aria-hidden="true" focusable="false"><path d="M7 1 1 8l6 7" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {%- render 'cj-menu-stone', link: grandchildlink, class: 'cj-menu-stone' -%}
                                              <span class="cj-menu-label">{{ grandchildlink.title | escape }}</span>
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- endif -%}
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- comment -%}
              The top bar's links. The bar hides them below 990px, where it has
              no room, so they sit here under the categories instead. Same menu
              as sections/announcement-bar.liquid resolves.
            {%- endcomment -%}
            {%- liquid
              assign top_bar_menu = settings.top_bar_menu
              if top_bar_menu == blank
                assign top_bar_menu = linklists['top-bar']
              endif
            -%}
            {%- if top_bar_menu.links.size > 0 or shop.customer_accounts_enabled -%}
              <ul class="menu-drawer__secondary list-unstyled" role="list">
                {%- comment -%}
                  Cullinan (2026-10-07, owner; moonmagic.com's placement): on phones the account icon
                  leaves the header and „Вход / Регистрация“ is the first of these quieter links, right
                  under the categories. It goes to Shopify's own sign-in (routes.account_login_url:
                  this store uses the new customer accounts, where one page signs in or creates an
                  account). A signed-in customer gets „Моят профил“ to the account page instead.
                  Phones only (medium-hide): tablets keep the header icon.
                {%- endcomment -%}
                {%- if shop.customer_accounts_enabled -%}
                  <li class="medium-hide large-up-hide">
                    {%- if customer -%}
                      <a href="{{ routes.account_url }}" class="menu-drawer__secondary-link menu-drawer__secondary-link--icon menu-drawer__account-link focus-inset"><span class="menu-drawer__secondary-icon" aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>Моят профил</a>
                    {%- else -%}
                      <a href="{{ routes.account_login_url }}" class="menu-drawer__secondary-link menu-drawer__secondary-link--icon menu-drawer__account-link focus-inset"><span class="menu-drawer__secondary-icon" aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>Вход / Регистрация</a>
                    {%- endif -%}
                  </li>
                {%- endif -%}
                {%- comment -%} 2026-10-13 (owner): „Магазин“ with its pin, to the shop in Google Maps (as in the desktop menu panel). {%- endcomment -%}
                <li>
                  <a
                    href="https://www.google.com/maps/search/?api=1&query=%D0%B1%D1%83%D0%BB.%20%D0%92%D0%B0%D1%81%D0%B8%D0%BB%20%D0%9B%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%2021%2C%20%D0%92%D0%B5%D0%BB%D0%B8%D0%BA%D0%BE%20%D0%A2%D1%8A%D1%80%D0%BD%D0%BE%D0%B2%D0%BE"
                    class="menu-drawer__secondary-link menu-drawer__secondary-link--icon focus-inset"
                    target="_blank"
                    rel="noopener"
                  ><span class="menu-drawer__secondary-icon" aria-hidden="true">{{ 'icon-map-pin.svg' | inline_asset_content }}</span>Магазин</a>
                </li>
                {%- for link in top_bar_menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="menu-drawer__secondary-link focus-inset"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- comment -%}
              Cullinan (2026-10-03, the owner: "i don't know if they put pictures on the phone but
              if they put somewhere we need that too"). moonmagic does: not inside the submenus,
              which are links only, but as a row of square picture tiles under the whole menu,
              swiped sideways. The tiles are the same pictures the desktop dropdowns carry (the
              header's "Mega menu image panel" blocks), one per block in block order. Each is an
              empty flat square until a picture is uploaded; with no blocks the row is not drawn.
            {%- endcomment -%}
            {%- liquid
              assign has_featured = false
              for block in section.blocks
                if block.type == 'mega_menu_promo'
                  assign has_featured = true
                  break
                endif
              endfor
            -%}
            {%- if has_featured -%}
              <ul class="menu-drawer__featured list-unstyled" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'mega_menu_promo' -%}
                    <li class="menu-drawer__featured-item" {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.link | default: '#' }}" class="menu-drawer__featured-link">
                        {%- if block.settings.image != blank -%}
                          {{
                            block.settings.image
                            | image_url: width: 600
                            | image_tag:
                              class: 'menu-drawer__featured-image',
                              widths: '240, 360, 480, 600',
                              sizes: '60vw',
                              loading: 'lazy',
                              alt: ''
                          }}
                        {%- else -%}
                          <span class="menu-drawer__featured-image menu-drawer__featured-image--empty" aria-hidden="true"></span>
                        {%- endif -%}
                        {%- if block.settings.label != blank -%}
                          <span class="menu-drawer__featured-label">{{ block.settings.label | escape }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if show_country_selector or show_language_selector -%}
              <div class="menu-drawer__localization header-localization">
                {%- if show_country_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if show_language_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            {% if show_social_links %}
              <ul class="list list-social list-unstyled" role="list">
                {%- if settings.social_twitter_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-twitter.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-facebook.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-pinterest.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-instagram.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tiktok.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tumblr_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tumblr.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_snapchat_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-snapchat.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-youtube.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_vimeo_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-vimeo.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {% endif %}
            {%- comment -%} 2026-10-13 (owner): the Bulgarian flag on the right of the Facebook / Instagram row. {%- endcomment -%}
            <svg class="menu-drawer__flag" viewBox="0 0 30 18" width="25" height="15" aria-hidden="true" focusable="false">
              <rect width="30" height="6" y="0" fill="#ffffff"/>
              <rect width="30" height="6" y="6" fill="#00966e"/>
              <rect width="30" height="6" y="12" fill="#d62612"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
