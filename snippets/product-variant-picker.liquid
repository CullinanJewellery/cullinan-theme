{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {% comment %}
    Cullinan: a colour option that only mirrors a material option is not drawn.

    The option with swatches exists so the product cards can show colour circles. On
    the product page the shopper chooses the material, in words, and the colour follows
    from it -- drawn as well, the two rows would say the same thing twice.

    An option with swatches is skipped only when another option, without swatches,
    covers it exactly: every value of that option contains exactly one colour name, and
    every colour name sits inside at least one value ("жълто злато" inside "14К жълто
    злато"). Anything short of that draws both rows as Dawn does, so a choice can never
    become unreachable, and a product with a colour option alone keeps its picker.

    The skipped option is still part of every variant, so it cannot just be left out of
    the request: Shopify would fill it with its first value and a shopper choosing rose
    gold could be sent a variant whose colour says yellow. product-variant-options.liquid
    sends the matching colour's id together with each visible value instead (`twin`).
  {% endcomment %}
  {%- liquid
    assign hidden_option = null
    assign shown_option = null

    for candidate in product.options_with_values
      assign candidate_swatches = candidate.values | map: 'swatch' | compact | size
      if candidate_swatches > 0
        assign hidden_option = candidate
        break
      endif
    endfor

    if hidden_option
      for candidate in product.options_with_values
        if shown_option
          break
        endif
        assign candidate_swatches = candidate.values | map: 'swatch' | compact | size
        if candidate.position == hidden_option.position or candidate_swatches > 0
          continue
        endif

        assign pairing_ok = true
        for candidate_value in candidate.values
          assign candidate_name = candidate_value.name | downcase
          assign name_matches = 0
          for hidden_value in hidden_option.values
            assign hidden_name = hidden_value.name | downcase
            if hidden_name != blank and candidate_name contains hidden_name
              assign name_matches = name_matches | plus: 1
            endif
          endfor
          if name_matches != 1
            assign pairing_ok = false
          endif
        endfor

        for hidden_value in hidden_option.values
          assign hidden_name = hidden_value.name | downcase
          assign name_found = false
          for candidate_value in candidate.values
            assign candidate_name = candidate_value.name | downcase
            if hidden_name != blank and candidate_name contains hidden_name
              assign name_found = true
            endif
          endfor
          unless name_found
            assign pairing_ok = false
          endunless
        endfor

        if pairing_ok
          assign shown_option = candidate
        endif
      endfor
    endif
  -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    {% # theme-check-disable %}
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {% # theme-check-enable %}
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- if shown_option and option.position == hidden_option.position -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign twin = null
        if shown_option and option.position == shown_option.position
          assign twin = hidden_option
        endif

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type,
            twin: twin
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type,
            twin: twin
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type,
                twin: twin
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
