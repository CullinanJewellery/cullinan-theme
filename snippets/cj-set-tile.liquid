{%- comment -%}
  One piece of a set card on the Комплекти page, shown in one metal: photo, name, price; opens the piece in that metal.
  A piece without that metal shows its own first photo and price and opens as it is.

  Accepts:
  - p: {Object} the product
  - metal: {String} the metal value, or '' when the set has no metals
  - lead: {Boolean} the large tile on top

  Usage:
  {% render 'cj-set-tile', p: piece, metal: 'x', lead: true %}
{%- endcomment -%}
{%- liquid
  assign v_match = null
  assign v_media = null
  assign price_min = null
  assign price_max = null

  if metal != ''
    for option in p.options_with_values
      assign o = option.name | downcase
      if o contains 'метал' or o contains 'материал' or o contains 'metal' or o contains 'material'
        assign idx = forloop.index0

        comment
          A product can have a Color option beside the material (product-twin-option.liquid); the photos hang on the
          Color, so only the variants whose Color is the one this material names count.
        endcomment
        assign twin_idx = -1
        assign twin_name = ''
        capture twin_pair
          render 'product-twin-option', product: p
        endcapture
        assign twin_positions = twin_pair | strip | split: ','
        if twin_positions.size == 2
          assign hidden_index = twin_positions[0] | minus: 1
          assign shown_index = twin_positions[1] | minus: 1
          if shown_index == idx
            assign hidden_option = p.options_with_values[hidden_index]
            capture twin_name
              render 'product-twin-match', colour_option: hidden_option, material_name: metal
            endcapture
            assign twin_name = twin_name | strip
            if twin_name != ''
              assign twin_idx = hidden_index
            endif
          endif
        endif

        for v in p.variants
          if twin_idx >= 0 and v.options[twin_idx] != twin_name
            continue
          endif
          if v.options[idx] == metal
            if v_match == null or v.available and v_match.available == false
              assign v_match = v
            endif
            if v_media == null and v.featured_media
              assign v_media = v.featured_media
            endif
            if price_min == null or v.price < price_min
              assign price_min = v.price
            endif
            if price_max == null or v.price > price_max
              assign price_max = v.price
            endif
          endif
        endfor
        break
      endif
    endfor
  endif

  assign tile_url = p.url
  assign tile_media = p.featured_media
  assign tile_price = p.price
  assign tile_varies = p.price_varies
  if v_match
    assign tile_url = v_match.url
    if v_media
      assign tile_media = v_media
    endif
    assign tile_price = price_min
    assign tile_varies = false
    if price_min != price_max
      assign tile_varies = true
    endif
  endif

  comment
    Through the page's collection, so the piece's navigation trail says Комплекти (as card-product.liquid does).
  endcomment
  assign tile_url = tile_url | within: collection

  comment
    The second photo, shown while the pointer is on the tile; the same choice as snippets/card-product.liquid: the first
    photo tied to no variant whose alt names an option value of this tile's variant, else the first such photo whose
    alt names no option value at all. A photo marked with another metal is never used.
  endcomment
  assign tile_second = null
  if p.media.size > 1 and tile_media
    assign free_ids = ','
    for v in p.variants
      if v.featured_media
        assign free_ids = free_ids | append: v.featured_media.id | append: ','
      endif
    endfor

    assign all_values = '|'
    for option in p.options_with_values
      for value in option.values
        assign value_down = value | append: '' | strip | downcase
        assign all_values = all_values | append: value_down | append: '|'
      endfor
    endfor

    assign owner = v_match
    if owner == null
      for v in p.variants
        if v.featured_media.id == tile_media.id
          assign owner = v
          break
        endif
      endfor
    endif
    assign owner_values = '|'
    if owner
      for value in owner.options
        assign value_down = value | append: '' | strip | downcase
        assign owner_values = owner_values | append: value_down | append: '|'
      endfor
    endif

    assign plain_second = null
    for m in p.media
      if m.media_type != 'image' or m.id == tile_media.id
        continue
      endif
      assign m_key = ',' | append: m.id | append: ','
      if free_ids contains m_key
        continue
      endif
      assign m_alt = m.alt | strip | downcase
      assign m_alt_key = '|' | append: m_alt | append: '|'
      if m_alt != blank and all_values contains m_alt_key
        if owner_values contains m_alt_key
          assign tile_second = m
          break
        endif
        continue
      endif
      if plain_second == null
        assign plain_second = m
      endif
    endfor
    if tile_second == null
      assign tile_second = plain_second
    endif
  endif

  if lead
    assign tile_width = 700
    assign tile_widths = '280, 420, 700'
    assign tile_sizes = '(min-width: 990px) 300px, 85vw'
  else
    assign tile_width = 400
    assign tile_widths = '160, 240, 400'
    assign tile_sizes = '(min-width: 990px) 150px, 42vw'
  endif
-%}
<a class="cj-set-card__tile{% if lead %} cj-set-card__tile--lead{% endif %}" href="{{ tile_url }}">
  <span class="cj-set-card__photo">
    {%- if tile_media -%}
      {{
        tile_media.preview_image
        | image_url: width: tile_width
        | image_tag: alt: '', loading: 'lazy', widths: tile_widths, sizes: tile_sizes
      }}
      {%- if tile_second -%}
        {{
          tile_second.preview_image
          | image_url: width: tile_width
          | image_tag: alt: '', class: 'cj-set-card__second', loading: 'lazy', widths: tile_widths, sizes: tile_sizes
        }}
      {%- endif -%}
    {%- endif -%}
  </span>
  <span class="cj-set-card__caption">
    <span class="cj-set-card__name">{{ p.title | escape }}</span>
    <span class="cj-set-card__price">
      {%- if tile_varies -%}от {% endif -%}
      {{- tile_price | money_without_trailing_zeros -}}
    </span>
  </span>
</a>
