{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay
  - twin: {Object, optional} the hidden colour option this option stands in for
    (Cullinan, see product-variant-picker.liquid). Nil for every other option.


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif
  -%}

  {% comment %}
    Cullinan: when this option stands in for a hidden colour option, find the colour
    this value belongs to (the one whose name it contains), so the id of both can be
    sent together, and work out sold-out state for that exact pair.

    Shopify's own `value.available` looks at the selected values of the options before
    this one -- and the hidden colour comes before the material -- so with one colour
    selected it would mark every other material as sold out, even where the matching
    colour-and-material variant is in stock. So the variants are checked directly: this
    value together with its own colour, and the selected values of every other
    visible option that comes before it.
  {% endcomment %}
  {%- liquid
    assign twin_value = null
    if twin
      assign value_name_down = value.name | downcase
      for twin_candidate in twin.values
        assign twin_name_down = twin_candidate.name | downcase
        if twin_name_down != blank and value_name_down contains twin_name_down
          assign twin_value = twin_candidate
        endif
      endfor
    endif

    if twin_value
      assign option_disabled = true
      assign value_index = option.position | minus: 1
      assign twin_index = twin.position | minus: 1
      for variant_candidate in product.variants
        unless variant_candidate.available
          continue
        endunless
        if variant_candidate.options[value_index] != value.name
          continue
        endif
        if variant_candidate.options[twin_index] != twin_value.name
          continue
        endif
        assign selection_matches = true
        for earlier_option in product.options_with_values
          if earlier_option.position < option.position and earlier_option.position != twin.position
            assign earlier_index = earlier_option.position | minus: 1
            if variant_candidate.options[earlier_index] != earlier_option.selected_value.name
              assign selection_matches = false
            endif
          endif
        endfor
        if selection_matches
          assign option_disabled = false
          break
        endif
      endfor
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}{% if twin_value %},{{ twin_value.id }}{% endif %}"
    data-option-name="{{ option.name | escape }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {% assign escaped_value = value | escape %}

  {%- if picker_type == 'swatch' -%}
    {%- capture help_text -%}
      <span class="visually-hidden">{{ escaped_value }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}
  {%- elsif picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      {% if value.selected %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
      {{ input_dataset }}
    >
    <label for="{{ input_id }}">
      {{ value -}}
      {{ label_unavailable }}
    </label>
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"
      {% if value.selected %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}
