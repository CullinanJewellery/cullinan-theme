{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign menu_key = link.title | strip | downcase
        assign visual_count = 0
        for block in section.blocks
          if block.type == 'visual_menu_item'
            assign block_key = block.settings.menu_item | strip | downcase
            if block_key == menu_key and block_key != blank
              assign visual_count = visual_count | plus: 1
            endif
          endif
        endfor
      -%}
      <li>
        {%- if link.links != blank or visual_count > 0 -%}
          {%- comment -%}
            The picture panel of this menu word, if the header has a block for it
            (snippets/header-mega-promo.liquid). Captured here, ahead of the <details>,
            because the dropdown itself has to say it has one: the class
            mega-menu__content--with-promo sets its minimum height and keeps the links clear
            of the picture (assets/crown.css, "The picture at the right of the dropdown").
            A menu word with a visual grid (visual_menu_item blocks) has no use for it.
          {%- endcomment -%}
          {%- capture mega_promo -%}
            {%- if visual_count == 0 -%}
              {%- render 'header-mega-promo', link: link, section: section -%}
            {%- endif -%}
          {%- endcapture -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                {% if link.url != blank and link.url != '#' %}
                  data-cj-menu-href="{{ link.url }}"
                {% endif %}
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {%- comment -%}
                  Cullinan (2026-10-03, the owner: "change the drop down arrow to something
                  else or make it look better"). The same arrow as every other drop-down on
                  the site: a thin chevron that flattens into a line while the menu is open
                  (snippets/icon-accordion-caret.liquid), in place of Dawn's solid caret.
                {%- endcomment -%}
                {% render 'icon-accordion-caret' %}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content{% if visual_count == 0 %} mega-menu__content--links{% if mega_promo != blank %} mega-menu__content--with-promo{% endif %}{% endif %} color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                {%- if visual_count > 0 -%}

                  {%- render 'header-visual-menu', link: link, section: section, context: 'mega' -%}

                {%- else -%}

                {%- comment -%}
                  The links, as columns in a row (assets/crown.css, "Text-column mega menu"), and
                  after them, outside the page-width body, the picture panel captured above. It is
                  placed against the dropdown's own corner, so it has to be a child of the dropdown
                  and not of the body: the body stops at the page's width, the corner is the page's
                  edge. Before 2026-10-03 the panel was a list item inside the links' own grid, then
                  a column of a grid in the body, which kept it 62px inside the edge.
                {%- endcomment -%}
                <div class="mega-menu__body page-width">
                <ul
                  class="mega-menu__list{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                  role="list"

                >
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="list-unstyled" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                </div>
                {{ mega_promo }}

                {%- endif -%}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
{%- comment -%}
  Cullinan (2026-10-06, owner): on a computer with a mouse, a menu word opens its
  dropdown under the cursor and stays open while the cursor travels into it (a short
  grace period covers the gap between the word and the panel); a click on the word
  opens its own collection (the menu link's own URL). Keyboard: Enter follows the
  link, Space still opens the dropdown. Touch screens keep Dawn's tap-to-open. The
  phone menu is the drawer and is not touched.
{%- endcomment -%}
<script>
  (function () {
    if (window.cullinanMenuHover) return;
    window.cullinanMenuHover = true;
    var pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    var timers = new WeakMap();

    function menus() {
      return document.querySelectorAll('.header__inline-menu details.mega-menu');
    }

    function open(details) {
      clearTimeout(timers.get(details));
      menus().forEach(function (other) {
        if (other !== details && other.open) {
          clearTimeout(timers.get(other));
          other.open = false;
          other.querySelector('summary').setAttribute('aria-expanded', 'false');
        }
      });
      if (!details.open) {
        details.open = true;
        details.querySelector('summary').setAttribute('aria-expanded', 'true');
      }
    }

    function closeSoon(details) {
      clearTimeout(timers.get(details));
      timers.set(
        details,
        setTimeout(function () {
          details.open = false;
          details.querySelector('summary').setAttribute('aria-expanded', 'false');
        }, 250)
      );
    }

    document.addEventListener('mouseover', function (event) {
      if (!pointer.matches) return;
      var details = event.target.closest && event.target.closest('.header__inline-menu details.mega-menu');
      if (details) open(details);
    });

    document.addEventListener('mouseout', function (event) {
      if (!pointer.matches) return;
      var details = event.target.closest && event.target.closest('.header__inline-menu details.mega-menu');
      if (!details) return;
      if (event.relatedTarget && details.contains(event.relatedTarget)) return;
      closeSoon(details);
    });

    function follow(summary, event) {
      var href = summary.getAttribute('data-cj-menu-href');
      if (!href) return false;
      event.preventDefault();
      window.location.href = href;
      return true;
    }

    document.addEventListener(
      'click',
      function (event) {
        var summary = event.target.closest && event.target.closest('.header__inline-menu details.mega-menu > summary');
        // A mouse click (detail > 0); keyboard activation reports 0 and keeps Dawn's toggle.
        if (!summary || !pointer.matches || event.detail === 0) return;
        follow(summary, event);
      },
      true
    );

    document.addEventListener(
      'keydown',
      function (event) {
        if (event.key !== 'Enter') return;
        var summary = event.target.closest && event.target.closest('.header__inline-menu details.mega-menu > summary');
        if (summary) follow(summary, event);
      },
      true
    );
  })();
</script>
