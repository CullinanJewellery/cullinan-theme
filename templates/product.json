{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating"
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "description": {
          "type": "description"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": false
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "specs": {
          "type": "product_specs",
          "settings": {
            "heading": "Качество и детайли",
            "icon": "none",
            "open_by_default": false
          }
        },
        "stone_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "За камъка",
            "icon": "none"
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Доставка и връщане",
            "icon": "truck"
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "product_list_limit": 4,
            "block_heading": "Подхождат си",
            "make_collapsible_row": true,
            "icon": "none",
            "enable_quick_add": false,
            "pagination_style": "counter"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Споделете"
          }
        }
      },
      "block_order": [
        "rating",
        "vendor",
        "title",
        "price",
        "description",
        "variant_picker",
        "quantity_selector",
        "inventory",
        "buy_buttons",
        "specs",
        "stone_tab",
        "shipping_tab",
        "complementary",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Може да ви хареса и",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
